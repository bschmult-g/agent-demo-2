# ==============================================================================
# Google Cloud & Vertex AI Configuration
# ==============================================================================
GOOGLE_CLOUD_PROJECT=green-carrier-500109-k2
GCP_PROJECT_ID=green-carrier-500109-k2
GOOGLE_CLOUD_PROJECT_NUMBER=799321431260
GCP_PROJECT_NUMBER=799321431260
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True
AGENT_MODEL_NAME=gemini-2.5-flash

# ==============================================================================
# SPIFFE Agent Identity Configuration (No Service Account Credentials)
# ==============================================================================
# GCP Organization ID used for SPIFFE Trust Domain formatting:
# principal://agents.global.org-{ORG_ID}.system.id.goog/resources/aiplatform/projects/{PROJECT_NUM}/locations/{LOCATION}/reasoningEngines/{ENGINE_ID}
AGENT_ORG_ID=799321431260
AGENT_ENGINE_ID=adk-spiffe-agent-engine

# ==============================================================================
# Agent Auth Manager 3-Legged OAuth (3LO) Configuration
# ==============================================================================
AUTH_PROVIDER_NAME=agent-3lo-auth-provider
OAUTH_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
OAUTH_CLIENT_ID=sample-client-id.apps.googleusercontent.com
OAUTH_CLIENT_SECRET=
OAUTH_SCOPES=https://www.googleapis.com/auth/calendar.readonly,https://www.googleapis.com/auth/userinfo.profile,https://www.googleapis.com/auth/userinfo.email
CONTINUE_URI=https://vertexaisearch.cloud.google.com/oauth-redirect

# ==============================================================================
# A2A Server Networking
# ==============================================================================
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
